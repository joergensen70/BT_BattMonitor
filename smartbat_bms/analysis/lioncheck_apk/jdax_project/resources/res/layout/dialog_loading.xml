<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ProgressBar
        android:id="@+id/loading_pb"
        android:layout_width="@dimen/DIMEN_50PX"
        android:layout_height="@dimen/DIMEN_50PX"
        android:indeterminate="true"
        android:indeterminateDrawable="@drawable/progress_color_rotate"
        android:layout_centerVertical="true"/>
    <TextView
        android:textSize="@dimen/text_size26"
        android:textColor="#ffffff"
        android:id="@+id/progress_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/DIMEN_10PX"
        android:text="加载中..."
        android:layout_toRightOf="@+id/loading_pb"
        android:layout_centerVertical="true"/>
</RelativeLayout>
