<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/lLayout_bg"
    android:background="@drawable/ll_bg_border"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="@dimen/text_size32"
        android:textColor="#22ff06"
        android:gravity="center"
        android:id="@+id/txt_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/DIMEN_50PX"
        android:layout_marginTop="@dimen/DIMEN_30PX"
        android:layout_marginRight="@dimen/DIMEN_50PX"/>
    <TextView
        android:textSize="@dimen/text_size28"
        android:textColor="#22ff06"
        android:gravity="center"
        android:id="@+id/txt_msg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/DIMEN_50PX"
        android:layout_marginTop="@dimen/DIMEN_30PX"
        android:layout_marginRight="@dimen/DIMEN_50PX"/>
    <ImageView
        android:background="@color/alertdialog_line"
        android:layout_width="match_parent"
        android:layout_height="@dimen/DIMEN_1PX"
        android:layout_marginTop="@dimen/DIMEN_50PX"/>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <Button
            android:textSize="@dimen/text_size28"
            android:textColor="#22ff06"
            android:gravity="center"
            android:id="@+id/btn_neg"
            android:background="@drawable/alertdialog_left_selector"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/DIMEN_100PX"
            android:layout_weight="1"/>
        <ImageView
            android:id="@+id/img_line"
            android:background="@color/alertdialog_line"
            android:layout_width="@dimen/DIMEN_1PX"
            android:layout_height="@dimen/DIMEN_100PX"/>
        <Button
            android:textSize="@dimen/text_size28"
            android:textColor="#22ff06"
            android:gravity="center"
            android:id="@+id/btn_pos"
            android:background="@drawable/alertdialog_right_selector"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/DIMEN_100PX"
            android:layout_weight="1"/>
    </LinearLayout>
</LinearLayout>
