<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/page_bg_color"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/broder_distance_left_value"
        android:layout_marginTop="@dimen/DIMEN_55PX"
        android:layout_marginRight="@dimen/broder_distance_left_value">
        <android.support.v7.widget.RecyclerView
            android:id="@+id/rlc_single_rlv"
            android:background="@drawable/rlv_bg_border"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </RelativeLayout>
</LinearLayout>
