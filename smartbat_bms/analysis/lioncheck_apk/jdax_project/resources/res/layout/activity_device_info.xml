<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/mianL"
    android:background="#000000"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:weightSum="1">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/DIMEN_70PX"
        android:layout_marginLeft="@dimen/DIMEN_30PX"
        android:layout_marginRight="@dimen/DIMEN_30PX">
        <ImageView
            android:id="@+id/tvbg"
            android:background="@color/black"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/DIMEN_70PX"
            android:src="@mipmap/lccpower"
            android:layout_alignRight="@+id/titleTV"
            android:layout_centerVertical="true"/>
        <TextView
            android:textSize="@dimen/DIMEN_38PX"
            android:textColor="#00ff00"
            android:gravity="center"
            android:id="@+id/titleTV"
            android:layout_width="@dimen/DIMEN_320PX"
            android:layout_height="match_parent"
            android:text="@string/app_name"
            android:layout_centerInParent="true"/>
        <ImageView
            android:id="@+id/backIM"
            android:background="@color/black"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/DIMEN_57PX"
            android:src="@mipmap/lchome"
            android:layout_centerVertical="true"/>
        <ImageView
            android:id="@+id/rightIM"
            android:background="@color/black"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/DIMEN_58PX"
            android:src="@mipmap/lcrlogo"
            android:scaleType="fitCenter"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"/>
        <ImageView
            android:id="@+id/weblink"
            android:background="@color/black"
            android:visibility="invisible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@mipmap/weblink"
            android:scaleType="fitCenter"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"/>
    </RelativeLayout>
    <android.support.v4.view.ViewPager
        android:id="@+id/vp"
        android:persistentDrawingCache="animation"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:flipInterval="30"
        android:layout_weight="1"/>
    <LinearLayout
        android:layout_gravity="center_horizontal"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:weightSum="1">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/DIMEN_54PX">
            <ImageView
                android:id="@+id/iv_limit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@mipmap/tpone"
                android:layout_centerInParent="true"/>
        </RelativeLayout>
        <ImageView
            android:id="@+id/downimg"
            android:background="@mipmap/panther"
            android:layout_width="match_parent"
            android:layout_height="@dimen/DIMEN_172PX"
            android:layout_alignParentBottom="true"/>
    </LinearLayout>
</LinearLayout>
