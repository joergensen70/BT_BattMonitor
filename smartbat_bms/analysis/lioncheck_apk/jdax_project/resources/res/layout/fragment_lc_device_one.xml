<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:background="#000000"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginLeft="30dp"
        android:layout_marginTop="@dimen/DIMEN_30PX"
        android:layout_marginRight="30dp"
        android:layout_weight="1">
        <RelativeLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <RelativeLayout
                android:id="@+id/rl_ampere_bg"
                android:layout_width="@dimen/DIMEN_310PX"
                android:layout_height="@dimen/DIMEN_310PX"
                android:layout_marginTop="@dimen/DIMEN_30PX">
                <ImageView
                    android:background="@mipmap/ico_ampere_bg"
                    android:layout_width="@dimen/DIMEN_310PX"
                    android:layout_height="@dimen/DIMEN_264PX"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/DIMEN_26PX"
                    android:layout_alignParentBottom="true"
                    android:layout_centerHorizontal="true">
                    <TextView
                        android:textSize="@dimen/text_size24"
                        android:textStyle="bold"
                        android:textColor="@color/btn_green_sel_color"
                        android:id="@+id/tv_current"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0.000A"/>
                    <TextView
                        android:textStyle="bold"
                        android:textColor="@color/btn_green_sel_color"
                        android:text="@string/current_text"
                        style="@style/tv_type_title_style"/>
                </LinearLayout>
                <com.gddai.lioncheck.widget.PositionScaleView
                    android:id="@+id/pslv_current"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
            </RelativeLayout>
            <TextView
                android:textSize="@dimen/text_size22"
                android:textColor="@color/while_color"
                android:gravity="center"
                android:background="@mipmap/circle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1"/>
        </RelativeLayout>
        <LinearLayout
            android:layout_gravity="center_horizontal"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="@dimen/DIMEN_310PX"
            android:layout_marginLeft="@dimen/DIMEN_30PX">
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@mipmap/lioncheck_icon"/>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp">
                <TextView
                    android:textSize="@dimen/text_size20"
                    android:textStyle="bold"
                    android:textColor="@color/while_color"
                    android:gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/lade"/>
                <TextView
                    android:textSize="@dimen/text_size22"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    android:gravity="center"
                    android:background="@drawable/et_green"
                    android:visibility="gone"
                    android:layout_width="@dimen/DIMEN_30PX"
                    android:layout_height="@dimen/DIMEN_30PX"
                    android:layout_marginLeft="@dimen/DIMEN_110PX"
                    android:text="1"/>
                <TextView
                    android:textSize="@dimen/text_size20"
                    android:textColor="@color/while_color"
                    android:gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/currentmehr"/>
            </LinearLayout>
            <View
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"/>
            <TextView
                android:textStyle="bold"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/currentMehrInfiTV"
                android:background="@drawable/merinfo_bg"
                android:layout_width="@dimen/DIMEN_200PX"
                android:layout_height="@dimen/DIMEN_60PX"
                android:text="mehr Info"/>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginLeft="30dp"
        android:layout_marginRight="30dp"
        android:layout_weight="1">
        <RelativeLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <RelativeLayout
                android:id="@+id/rl_volt_bg"
                android:layout_width="@dimen/DIMEN_310PX"
                android:layout_height="@dimen/DIMEN_310PX"
                android:layout_marginTop="@dimen/DIMEN_30PX">
                <ImageView
                    android:background="@mipmap/ico_volt_bg"
                    android:layout_width="@dimen/DIMEN_310PX"
                    android:layout_height="@dimen/DIMEN_264PX"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/DIMEN_26PX"
                    android:layout_alignParentBottom="true"
                    android:layout_centerHorizontal="true">
                    <TextView
                        android:textSize="@dimen/text_size24"
                        android:textStyle="bold"
                        android:textColor="@color/btn_green_sel_color"
                        android:layout_gravity="center"
                        android:id="@+id/tv_voltage"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0.000V"/>
                    <TextView
                        android:textStyle="bold"
                        android:textColor="@color/btn_green_sel_color"
                        android:gravity="center"
                        android:text="@string/voltage_text"
                        style="@style/tv_type_title_style"/>
                </LinearLayout>
                <com.gddai.lioncheck.widget.PositionScaleView
                    android:id="@+id/pslv_voltage"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
            </RelativeLayout>
            <TextView
                android:textSize="@dimen/text_size22"
                android:textColor="@color/while_color"
                android:gravity="center"
                android:background="@mipmap/circle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2"/>
        </RelativeLayout>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="@dimen/DIMEN_310PX">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/DIMEN_30PX">
                <TextView
                    android:textSize="@dimen/text_size20"
                    android:textStyle="bold"
                    android:textColor="@color/while_color"
                    android:gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/spannung"/>
                <TextView
                    android:textSize="@dimen/text_size22"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    android:gravity="center"
                    android:background="@drawable/et_green"
                    android:visibility="gone"
                    android:layout_width="@dimen/DIMEN_30PX"
                    android:layout_height="@dimen/DIMEN_30PX"
                    android:layout_marginLeft="@dimen/DIMEN_110PX"
                    android:text="2"/>
                <TextView
                    android:textSize="@dimen/text_size20"
                    android:textColor="@color/while_color"
                    android:gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/voltagemehr"/>
            </LinearLayout>
            <View
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"/>
            <TextView
                android:textStyle="bold"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/voltageMehrInfiTV"
                android:background="@drawable/merinfo_bg"
                android:layout_width="@dimen/DIMEN_200PX"
                android:layout_height="@dimen/DIMEN_60PX"
                android:text="mehr Info"/>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginLeft="30dp"
        android:layout_marginRight="30dp"
        android:layout_weight="1">
        <RelativeLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <RelativeLayout
                android:id="@+id/ll_soc"
                android:layout_width="@dimen/DIMEN_310PX"
                android:layout_height="@dimen/DIMEN_310PX"
                android:layout_marginTop="@dimen/DIMEN_30PX">
                <LinearLayout
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true">
                    <TextView
                        android:textSize="@dimen/text_size24"
                        android:textStyle="bold"
                        android:textColor="@color/btn_green_sel_color"
                        android:id="@+id/tv_soc"
                        android:layout_marginTop="@dimen/DIMEN_20PX"
                        android:text="0%"
                        style="@style/tv_type_value_style"/>
                    <TextView
                        android:textStyle="bold"
                        android:textColor="@color/btn_green_sel_color"
                        android:text="@string/soc_text"
                        style="@style/tv_type_title_style"/>
                </LinearLayout>
                <com.gddai.lioncheck.widget.CircleProgressView
                    android:id="@+id/cpv_progess"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
            </RelativeLayout>
            <TextView
                android:textSize="@dimen/text_size22"
                android:textColor="@color/while_color"
                android:gravity="center"
                android:background="@mipmap/circle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="3"/>
        </RelativeLayout>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="@dimen/DIMEN_340PX"
            android:layout_marginLeft="@dimen/DIMEN_30PX">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="@dimen/text_size20"
                    android:textStyle="bold"
                    android:textColor="@color/while_color"
                    android:gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/kapazit_t_res_0x7f0d0080"/>
                <TextView
                    android:textSize="@dimen/text_size22"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    android:gravity="center"
                    android:background="@drawable/et_green"
                    android:visibility="gone"
                    android:layout_width="@dimen/DIMEN_30PX"
                    android:layout_height="@dimen/DIMEN_30PX"
                    android:layout_marginLeft="@dimen/DIMEN_110PX"
                    android:text="3"/>
                <TextView
                    android:textSize="@dimen/text_size20"
                    android:textColor="@color/while_color"
                    android:gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/soccontent"/>
            </LinearLayout>
            <View
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"/>
            <TextView
                android:textStyle="bold"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/socMehrInfiTV"
                android:background="@drawable/merinfo_bg"
                android:layout_width="@dimen/DIMEN_200PX"
                android:layout_height="@dimen/DIMEN_60PX"
                android:text="mehr Info"/>
            <View
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"/>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <TextView
                    android:id="@+id/tv_battery_state_title"
                    android:text="@string/state_text"
                    style="@style/tv_type_title_style"/>
                <TextView
                    android:textColor="@color/btn_green_sel_color"
                    android:id="@+id/tv_battery_state"
                    android:layout_marginLeft="@dimen/DIMEN_10PX"
                    android:minWidth="@dimen/DIMEN_80PX"
                    android:text="Standby"
                    style="@style/tv_type_value_style"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <TextView
                    android:text="@string/cycle_text"
                    android:layout_centerVertical="true"
                    style="@style/tv_type_title_style"/>
                <TextView
                    android:textColor="@color/btn_green_sel_color"
                    android:id="@+id/tv_cycle"
                    android:layout_marginLeft="@dimen/DIMEN_10PX"
                    android:text="0"
                    style="@style/tv_type_value_style"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
    <View
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_weight="0.2"/>
</LinearLayout>
