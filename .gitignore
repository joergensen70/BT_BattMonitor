# Large Android bugreport/dumpstate files (can be hundreds of MB)
**/dumpstate*.txt
**/bugreport*.zip
smartbat_bms/_tmp_bugreport_extract/
smartbat_bms/_tmp_bugreport.zip

# Release APKs are committed to rel/ for distribution
# (no ignore for smartbat_bms/rel/)

# Captured bugreport archives and dump folders
smartbat_bms/captures/

# Temporary fix/helper scripts
smartbat_bms/_fix*.ps1

# Auto-generated Flutter plugin registration (regenerated on build)
smartbat_bms/android/app/src/main/java/io/flutter/plugins/GeneratedPluginRegistrant.java

# JADX GUI binary (large standalone app, not source)
tools/jadx-gui-*/

# Python virtual environment
.venv/

# Flutter build outputs
smartbat_bms/build/
smartbat_bms/.dart_tool/
smartbat_bms/.flutter-plugins
smartbat_bms/.flutter-plugins-dependencies
smartbat_bms/.packages

# Old legacy app (boilerplate, not the real app)
smartbat_bms/bt_batt_monitor/

# APK binaries in analysis folder (large, reproducible from source)
smartbat_bms/analysis/**/*.apk

# .NET build outputs in tools
tools/ble_scanner_dotnet/bin/
tools/ble_scanner_dotnet/obj/
